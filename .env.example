# ── Server ─────────────────────────────────────────────
PROPOSAL_PORT=5002
PROPOSAL_HOST=127.0.0.1
PROPOSAL_DEBUG=false

# Flask session signing key — REQUIRED in production.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── LLM (OpenRouter / OpenAI-compatible) ────────────────
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash
# Separate model for the blind verifier (LLM-as-a-judge)
VERIFIER_MODEL=google/gemini-2.5-pro

# ── Sightline evidence bridge (OPTIONAL) ─────────────────
# Path to a local Sightline checkout. When set, the proposal
# engine can ground citations with ReliefWeb/HDX live data.
# When unset, the bridge is disabled and the pipeline runs
# fully standalone (zero-crash).
# SIGHTLINE_ROOT=~/Documents/reliefweb/RedAgent
